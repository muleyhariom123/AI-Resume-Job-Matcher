# ============================================================================
# AI Resume Matcher - Environment Configuration Example
# ============================================================================
# Copy this file to .env and configure values before starting the application:
#   copy .env.example .env
#
# NOTE: Never commit .env or real credentials/secrets to version control.
# ============================================================================

# Environment mode: 'development' or 'production'
FLASK_ENV=development

# Secret Key: Required in production. Minimum 32 random characters.
# Generate one using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-random-32-char-string-in-production

# Database file location (SQLite)
DATABASE_PATH=instance/resume_matcher.db

# Storage folder for candidate uploaded resumes
UPLOAD_FOLDER=uploads

# Cookie security: Set to 'true' in production when running behind HTTPS/SSL
SESSION_COOKIE_SECURE=false

# Rate Limiting configuration
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_ATTEMPTS=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# Server port and host (for Waitress WSGI)
PORT=5000
HOST=127.0.0.1

# ============================================================================
# SMTP Email Service Configuration (Optional for Password Recovery)
# If left blank, self-service email password recovery is safely disabled.
# ============================================================================
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@yourdomain.com

# ============================================================================
# Admin Bootstrap Configuration (Used only by bootstrap_admin.py)
# ============================================================================
ADMIN_FULL_NAME=
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
